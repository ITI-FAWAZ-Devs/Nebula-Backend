generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  LOCAL
  GITHUB
  GOOGLE
  GITLAB
  MICROSOFT
}

enum ConnectionProvider {
  GITHUB
  GITLAB
  BITBUCKET
}

enum CredentialType {
  PAT
  OAUTH_TOKEN
  APP_INSTALLATION
}

enum SubscriptionTier {
  FREE
  PRO
  ULTRA
}

model User {
  id                      String           @id @default(uuid())
  email                   String           @unique
  password                String?
  fullName                String?
  avatar                  String?
  isEmailVerified         Boolean          @default(false)
  refreshToken            String?
  subscriptionTier        SubscriptionTier @default(FREE)
  currentPeriodStart      DateTime         @default(now())
  currentPeriodEnd        DateTime?
  generationsUsedThisPeriod Int            @default(0)
  totalGenerationsUsed    Int              @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts            Account[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  repositories        Repository[]
  importedRepositories Repository[]       @relation("RepoImportedBy")
  githubToken         UserGithubToken?
  ownedOrganizations  Organization[]
  memberships         OrganizationMember[]
  usageLogs           UsageLog[]
  connections         Connection[]
  createdConnections  Connection[]       @relation("ConnectionCreatedBy")
  conversationThreads ConversationThread[]

  @@map("users")
}

model Account {
  id               String       @id @default(uuid())
  userId           String
  provider         AuthProvider
  providerId       String
  providerUsername String?
  providerAvatar   String?
  accessToken      String?
  refreshToken     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@unique([userId, provider])
  @@map("accounts")
}

model VerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model UserGithubToken {
  id              String   @id @default(uuid())
  userId          String   @unique
  encryptedToken  String
  scopes          String[]
  lastValidatedAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_github_tokens")
}

model Connection {
  id               String             @id @default(uuid())
  provider         ConnectionProvider @default(GITHUB)
  credentialType   CredentialType     @default(PAT)
  label            String?
  encryptedToken   String
  scopes           String[]
  lastValidatedAt  DateTime
  isValid          Boolean            @default(true)

  userId           String?
  orgId            String?
  createdByUserId  String

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user             User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization     Organization?      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdByUser    User               @relation("ConnectionCreatedBy", fields: [createdByUserId], references: [id])
  repositories     Repository[]

  @@unique([userId, provider, label])
  @@unique([orgId, provider, label])
  @@index([userId, provider])
  @@index([orgId, provider])
  @@map("connections")
}

enum MemberStatus {
  PENDING
  ACTIVE
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner        User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  roles        Role[]
  members      OrganizationMember[]
  repositories Repository[]
  connections  Connection[]

  @@map("organizations")
}

model Role {
  id          String   @id @default(uuid())
  orgId       String
  name        String
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members      OrganizationMember[]

  @@unique([orgId, name])
  @@map("roles")
}

model OrganizationMember {
  id          String       @id @default(uuid())
  orgId       String
  userId      String
  roleId      String
  status      MemberStatus @default(PENDING)
  inviteToken String?      @unique
  invitedBy   String?
  joinedAt    DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@map("organization_members")
}

enum RepositoryStatus {
  IMPORTED
  CLONING
  INDEXING
  READY
  FAILED
}

model Repository {
  id                String             @id @default(uuid())
  githubRepoId      String?
  providerRepoId    String?
  provider          ConnectionProvider @default(GITHUB)
  name              String
  owner             String
  defaultBranch     String
  isPrivate         Boolean            @default(false)
  cloneUrl          String
  localPath         String?
  status            RepositoryStatus   @default(IMPORTED)
  lastIndexedCommit String?
  lastDocumentedAt  DateTime?
  documentedCommit  String?
  userId            String
  organizationId    String?
  connectionId      String?
  importedByUserId  String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  importedByUser    User?              @relation("RepoImportedBy", fields: [importedByUserId], references: [id], onDelete: SetNull)
  organization      Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  connection        Connection?        @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  analysisJobs      AnalysisJob[]
  documentationJobs DocumentationJob[]
  generatedDocs     GeneratedDoc[]
  conversationThreads ConversationThread[]

  @@unique([userId, organizationId, githubRepoId])
  @@map("repositories")
}

enum DocStatus {
  PENDING
  RETRIEVING
  GENERATING
  VERIFYING
  COMPLETED
  FAILED

  @@map("doc_status")
}

model GeneratedDoc {
  id                String    @id @default(uuid())
  repositoryId      String
  version           Int
  status            DocStatus @default(PENDING)
  commitSha         String?
  triggeredByUserId String?
  model             String
  verificationScore Float?
  errorMessage      String?
  generatedAt       DateTime?
  checkpoint        Json?
  resumeCount       Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  repository Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  sections    DocSection[]

  @@unique([repositoryId, version])
  @@index([repositoryId, status])
  @@map("generated_docs")
}

model DocSection {
  id              String   @id @default(uuid())
  docId           String
  key             String
  title           String
  order           Int
  contentMd       String
  sourceFiles     String[]
  diagramMermaid  String?
  verified        Boolean  @default(false)
  verificationNotes String?
  createdAt       DateTime @default(now())

  doc GeneratedDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@unique([docId, key])
  @@index([docId, order])
  @@map("doc_sections")
}

enum AnalysisJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model AnalysisJob {
  id           String            @id @default(uuid())
  repositoryId String
  status       AnalysisJobStatus @default(QUEUED)
  stage        String?
  error        String?
  queueJobId   String?
  checkpoint   Json?
  resumeCount  Int               @default(0)
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@map("analysis_jobs")
}

enum DocumentationJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model DocumentationJob {
  id           String                 @id @default(uuid())
  repositoryId String
  status       DocumentationJobStatus @default(PENDING)
  stage        String?
  progress     Int?
  error        String?
  queueJobId   String?
  checkpoint   Json?
  resumeCount  Int                    @default(0)
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@map("documentation_jobs")
}

model UsageLog {
  id              String           @id @default(uuid())
  userId          String
  repositoryId    String?
  jobType         String
  tierAtExecution SubscriptionTier
  llmModel        String?
  embeddingModel  String?
  createdAt       DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("usage_logs")
}

model ConversationThread {
  id           String   @id @default(uuid())
  repositoryId String
  userId       String
  title        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  messages   ConversationMessage[]
  repository Repository            @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([repositoryId, userId])
  @@map("conversation_threads")
}

model ConversationMessage {
  id        String   @id @default(uuid())
  threadId  String
  role      String
  content   String
  citations Json?
  createdAt DateTime @default(now())

  thread ConversationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@map("conversation_messages")
}


