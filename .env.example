# ── App ──
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# ── Database ──
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nebula?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nebula

# ── JWT ──
JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── GitHub OAuth ──
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback

# ── Mail (SMTP) ──
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=your-email@example.com
MAIL_PASS=your-email-password
MAIL_FROM="Nebula <noreply@nebula.dev>"

# ── Encryption (32-byte key in hex format - 64 hex characters) ──
# To generate a new secure key, run in your terminal:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=put-it-here

# ── Redis (BullMQ) ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Workspace ──
WORKSPACE_ROOT=./workspace

# ── Graphify CLI ──
# Default (empty GRAPHIFY_ARGS) runs:
#   graphify extract {projectPath} --code-only --no-cluster --out {graphifyDir}
# Override with placeholders: {projectPath} {graphifyDir} {outputPath}
GRAPHIFY_BIN=graphify
GRAPHIFY_ARGS=
GRAPHIFY_TIMEOUT_MS=300000

# ── Neo4j ──
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# ── Chromadb ──
CHROMA_HOST=api.trychroma.com
CHROMA_API_KEY=your-chroma-api-key
CHROMA_TENANT=your-chroma-tenant
CHROMA_DATABASE=nebula

# ── Gemini ──
GEMINI_API_KEY=your-gemini-api-key
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_EMBEDDING_DIMENSIONS=768