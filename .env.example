# --- App ---
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nebula?schema=public"
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=nebula

# --- JWT ---
JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ACCESS_EXPIRATION=120m
JWT_REFRESH_EXPIRATION=7d

# --- GitHub OAuth ---
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback

# --- GOOGLE OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# --- Mail (SMTP) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=your-email@example.com
MAIL_PASS=your-email-password
MAIL_FROM="Nebula <noreply@nebula.dev>"

# --- Encryption (32-byte key in hex format - 64 hex characters) ---
# To generate a new secure key, run in your terminal:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=put-it-here

# --- Redis (BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Workspace ---
WORKSPACE_ROOT=./workspace

# --- Graphify CLI ---
# Default (empty GRAPHIFY_ARGS) runs:
#   graphify extract {projectPath} --code-only --no-cluster --out {graphifyDir}
# Override with placeholders: {projectPath} {graphifyDir} {outputPath}
GRAPHIFY_BIN=graphify
GRAPHIFY_ARGS=
GRAPHIFY_TIMEOUT_MS=300000

# --- Neo4j ---
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=your-aura-instance-id
AURA_INSTANCENAME=your-aura-instance-name

# --- Chromadb ---
CHROMA_HOST=api.trychroma.com
CHROMA_API_KEY=your-chroma-api-key
CHROMA_TENANT=your-chroma-tenant
CHROMA_DATABASE=nebula

# --- Gemini (primary provider) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_LLM_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_EMBEDDING_DIMENSIONS=768

# --- AWS Bedrock via SBG gateway (fallback provider) ---
# The gateway is NOT native AWS: it issues its own API keys and is called with
# a plain HTTP client against its normalized API. Do NOT add AWS SDK or
# SigV4/bearer-token AWS auth config.
SBG_API_KEY=your-sbg-gateway-api-key
# Full host + /api/v1 (confirmed). Allowed models are listed at:
#   GET {BEDROCK_GATEWAY_BASE_URL}/student/models
# NOTE: gateway model IDs differ from AWS-native ones (e.g. the text embedding
# model is "amazon.titan-embed-text-v2:0:8k", NOT "amazon.titan-embed-text-v2:0").
BEDROCK_GATEWAY_BASE_URL=http://apiaccess.iti.net.eg/api/v1
BEDROCK_LLM_MODEL=anthropic.claude-sonnet-4-6,anthropic.claude-haiku-4-5-20251001-v1:0,openai.gpt-oss-120b-1:0
BEDROCK_LLM_MODEL_STRONG=openai.gpt-oss-120b-1:0
# The gateway's default max_tokens exceeds Bedrock's per-model token limit and
# gets rejected (ValidationException), so it MUST be set explicitly.
BEDROCK_MAX_TOKENS=16384
# Abort timeout for a single provider LLM/embedding request. If the gateway
# accepts a connection but never responds, the call is aborted and treated as a
# transient failure so the chain falls through to the next provider instead of
# hanging the pipeline forever.
LLM_TIMEOUT_MS=60000
EMBEDDING_TIMEOUT_MS=60000
# Ordered candidate list; the first model that answers a probe is pinned per
# process. The student key is provisioned for only some of these models.
BEDROCK_EMBEDDING_MODELS=us.cohere.embed-v4:0
BEDROCK_EMBEDDING_DIMENSIONS=1024

# --- OpenRouter (Tier 2 — embeddings only, free tier) ---
# OpenAI-compatible embeddings endpoint; the free tier is request-count limited
# (20 req/min, 50/day without credits, 1,000/day with $10+ added), so batches
# are sent as a single `input` array. Provider is skipped until the key is set.
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
# Confirmed live via a real call: 2048-dim vectors, $0 cost.
OPENROUTER_EMBEDDING_DIMENSIONS=2048

# --- AI provider fallback chains (comma-separated, independent per capability) ---
# Legacy AI_PROVIDER_ORDER is honored when the per-capability vars are absent.
AI_PROVIDER_ORDER=gemini
LLM_PROVIDER_ORDER=gemini
EMBEDDING_PROVIDER_ORDER=gemini

# --- Documentation / RAG indexing pipeline ---
# Number of files described in parallel during the "describe_files" stage.
DOCUMENTATION_DESCRIBE_CONCURRENCY=4
# Optional fixed pause between per-file descriptions (ms); 0 disables it.
DOCUMENTATION_DESCRIBE_DELAY_MS=0

# --- Code-grounded drafting pipeline ---
# Bounds for the source-code evidence attached to drafting contexts.
# Max files that receive code snippets in one context.
DRAFTING_CODE_CONTEXT_MAX_FILES=12
# Per-file snippet cap; files are truncated to this length.
DRAFTING_CODE_CONTEXT_MAX_CHARS_PER_FILE=4000
# Total code characters allowed in one context; files beyond the budget keep
# their descriptions only.
DRAFTING_CODE_CONTEXT_MAX_TOTAL_CHARS=32000

# --- Voice Agent (local STT + TTS, no cloud API required) ---
# Set to false to disable the /voice WebSocket gateway entirely.
VOICE_ENABLED=true
# Absolute path to the compiled whisper.cpp 'main' binary.
# Build: cd whisper.cpp && make
# Download model: bash models/download-ggml-model.sh base.en
VOICE_WHISPER_BIN=/home/<user>/.local/opt/whisper.cpp/repo/build/bin/whisper-cli
VOICE_WHISPER_MODEL=/home/<user>/.local/opt/whisper.cpp/repo/models/ggml-base.en.bin
# Absolute path to the Piper binary.
# Download from: https://github.com/rhasspy/piper/releases
# Download voice from: https://huggingface.co/rhasspy/piper-voices
VOICE_PIPER_BIN=/home/<user>/.local/opt/piper/piper/piper
VOICE_PIPER_MODEL=/home/<user>/.local/opt/piper/voices/en_US-lessac-medium.onnx
# PCM sample rate whisper expects (16000 recommended, must match frontend).
VOICE_SAMPLE_RATE=16000
# Silence duration in ms before auto-committing an utterance.
VOICE_SILENCE_DURATION_MS=1200
